# Julia specific
Manifest.toml
!dev/Manifest.toml
*.jl.cov
*.jl.*.cov
*.jl.mem
deps/deps.jl

# IDE / local agent state
.vscode/
.idea/
.codex/
.zed/
.grok/
.kilo/
.beads/
.cursor/
.kiro/
.opencode/
.mimocode/
.claude/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data files (root-level only — outputs/root_artifacts/ must stay tracked)
/*.csv
/*.json
/*.h5

# Temporary files
*.tmp
*.bak
*~

# Session logs (contain code snippets that confuse Julia LSP)
session-ses_*.md

# Root-level binary artifacts (should live in outputs/)
/*.png
/*.txt

# Build artifacts
build/
dist/
.julia_depot/
*.o
*.so
*.dylib
*.dll

# Generated outputs (dashboards, plots, reports)
outputs/*
!outputs/root_artifacts/

# Imported corinth-canal artifacts (symlinks/copies from ../corinth-canal/artifacts)
data/corinth_runs/*
!data/corinth_runs/.gitkeep
!data/corinth_runs/imported_runs_index.csv

# Model data directories (GGUF checkpoints / placeholders — gitignored)
# Cleaned per GH#40 / MET-115 (Grok Build 0.1 model): unused GGUF-style placeholders deleted.
# Real data lives in data/corinth_runs/<slug>/ and outputs/<slug>/{dashboards,sr_results}/.
# Broad pattern to prevent future clutter (specific per-dir lines removed).
data/*gguf/*
data/*GGUF/*
!data/*/.gitkeep
# Also ignore any leftover GGUF-style in outputs/ (results use clean slugs).
outputs/*gguf/*
outputs/*GGUF/*

# Selected runs manifest (machine-local absolute paths)
data/selected_runs.toml
